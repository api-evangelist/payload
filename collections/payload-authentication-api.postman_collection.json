  "info": {
    "_postman_id": "cc200001-d31a-4610-8723-600d4cde51ac",
    "name": "Payload CMS REST Authentication API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Payload is a TypeScript-first headless CMS and application framework that auto-generates REST and GraphQL APIs from collection schemas. The REST API exposes collections at /api/{collection-slug}, globals at /api/globals/{global-slug}, auth operations at /api/{user-collection}/login etc., and user preferences at /api/payload-preferences/{key}. Authentication uses JWT tokens issued by the login endpoint.\n\nContact Support:\n Name: Payload",
      "type": "text/plain"
    }
  }
